# Konvene settings. Copy this file to .env for your computer, or set the same names as
# environment variables in Netlify, Vercel or any host. Everything is optional.
#
# KONVENE_* values are built into the page, so anyone can read them.
# Secrets (the TURN section) never start with KONVENE_ and stay on the server.

# ---- Public settings (built into the page) ----

# The name people see: page titles, the wordmark, messages.
KONVENE_NAME=Konvene

# Calls only meet browsers using the same app ID. Pick your own to keep your
# deployment's calls separate from every other copy of Konvene.
KONVENE_APP_ID=konvene-calls-v1

# Shown on the privacy page: who runs this copy, and a contact link (web page or mailto:).
KONVENE_OPERATOR=
KONVENE_CONTACT_URL=

# Where your copy's source code lives. The GitHub links on the site point here.
# The AGPL asks you to offer your source to people using a changed version.
KONVENE_REPO_URL=https://github.com/rakeshmenon/konvene

# Your own Nostr relays for the handshake, comma separated (wss://...). Empty: public defaults.
KONVENE_RELAYS=

# Most people in one call, 2 to 8 (every browser sends video to every other one).
KONVENE_MAX_PEOPLE=6

# Features to switch off, comma separated: recording, captions, screenshare, chat, effects, reactions
KONVENE_DISABLE=

# What new calls start with on the pre-join page (people can still change it).
KONVENE_PASSCODE_DEFAULT=false
KONVENE_ASK_FIRST_DEFAULT=false

# Your site's address, for link previews. Netlify and Vercel fill this in for you.
KONVENE_SITE_URL=

# Folder with your logo, icons and custom.css (see custom.example/ and docs/customising.md).
KONVENE_CUSTOM_DIR=custom

# Show "this is the public demo" notes. Only for the official demo.
KONVENE_DEMO=false

# Where the browser asks for relay passwords. Leave unset for the built-in /api/turn
# function; set it empty to turn relays off.
# KONVENE_TURN_ENDPOINT=/api/turn

# A fixed TURN server built into the page, for hosts without functions.
# Visible to anyone: only use credentials made for this.
# KONVENE_TURN_URLS=turns:turn.example.com:443?transport=tcp
# KONVENE_TURN_USERNAME=
# KONVENE_TURN_CREDENTIAL=

# ---- Secrets (server only, read by the /api/turn function) ----

# Cloudflare Realtime TURN: dashboard > Realtime > TURN Server > create a key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Or any other TURN server (coturn and others), comma separated URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# How long relay passwords last, in seconds (default 14400, four hours).
TURN_TTL=14400

# Port for `npm run dev` and `npm run serve`.
PORT=8790

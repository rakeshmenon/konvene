# Klatch settings. Copy this file to .env for your computer, or set the same names as
# environment variables in Netlify, Vercel or any host. Everything is optional.
#
# KLATCH_* values are built into the page, so anyone can read them.
# Secrets (the TURN section) never start with KLATCH_ and stay on the server.

# ---- Public settings (built into the page) ----

# Calls only meet browsers using the same app ID. Pick your own to keep your
# deployment's calls separate from every other copy of Klatch.
KLATCH_APP_ID=klatch-calls-v1

# Shown on the privacy page: who runs this copy, and a contact link (web page or mailto:).
KLATCH_OPERATOR=
KLATCH_CONTACT_URL=

# Where your copy's source code lives. The GitHub links on the site point here.
# The AGPL asks you to offer your source to people using a changed version.
KLATCH_REPO_URL=https://github.com/rakeshmenon/klatch

# Your own Nostr relays for the handshake, comma separated (wss://...). Empty: public defaults.
KLATCH_RELAYS=

# Show "this is the public demo" notes. Only for the official demo.
KLATCH_DEMO=false

# Where the browser asks for relay passwords. Leave unset for the built-in /api/turn
# function; set it empty to turn relays off.
# KLATCH_TURN_ENDPOINT=/api/turn

# A fixed TURN server built into the page, for hosts without functions.
# Visible to anyone: only use credentials made for this.
# KLATCH_TURN_URLS=turns:turn.example.com:443?transport=tcp
# KLATCH_TURN_USERNAME=
# KLATCH_TURN_CREDENTIAL=

# ---- Secrets (server only, read by the /api/turn function) ----

# Cloudflare Realtime TURN: dashboard > Realtime > TURN Server > create a key.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Or any other TURN server (coturn and others), comma separated URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# How long relay passwords last, in seconds (default 14400, four hours).
TURN_TTL=14400

# Port for `npm run dev` and `npm run serve`.
PORT=8790

{
  "name": "konvene",
  "version": "1.1.0",
  "private": true,
  "description": "Free, private video calls in the browser. Peer to peer, no account, effects on your own device.",
  "license": "AGPL-3.0-only",
  "author": "Rakesh Menon",
  "homepage": "https://github.com/rakeshmenon/konvene#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakeshmenon/konvene.git"
  },
  "bugs": {
    "url": "https://github.com/rakeshmenon/konvene/issues"
  },
  "keywords": [
    "video-call",
    "webrtc",
    "peer-to-peer",
    "privacy",
    "mediapipe",
    "background-blur"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node tests/run.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "1.2.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "playwright": "1.64.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
